# ==============================================================================
# Morning Review — Configuration Exemple (.env.example)
# Copier vers .env et adapter les valeurs pour le développement local.
# ==============================================================================

# --- Application ---
APP_ENV=development
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
# Clé secrète (32+ octets hex/base64) pour chiffrement Fernet des connecteurs et signature HMAC des liens email
APP_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# --- Mode Utilisateur MVP vs Multi-Utilisateurs OIDC (Post-MVP) ---
# En MVP : AUTH_MODE=single_user utilise BOOTSTRAP_USER_ID (UUID fixe, non auto-incrémenté)
# Post-MVP : AUTH_MODE=oidc rend l'authentification OIDC obligatoire
AUTH_MODE=single_user
BOOTSTRAP_USER_ID=019326b0-7c00-7000-8000-000000000001
BOOTSTRAP_USER_EMAIL=votre.compte@gmail.com
# Jeton statique optionnel pour protéger l'API et l'ingestion Edge en mode MVP avant OIDC
MVP_API_TOKEN=change-me-mvp-api-token

# --- Authentification OIDC Obligatoire (Post-MVP : Keycloak / Authentik / PocketID) ---
OIDC_ISSUER_URL=https://auth.example.com/application/o/morning-review/
OIDC_CLIENT_ID=morning-review-web
OIDC_AUDIENCE=morning-review-api

# --- PostgreSQL (avec extensions vector + pg_trgm) ---
DATABASE_URL=postgresql+psycopg://morning:morning@localhost:5432/morning_review

# --- Stockage Objet Compatible S3 (Local MinIO/SeaweedFS ou Production Backblaze B2) ---
AWS_ENDPOINT_URL_S3=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET_NAME=morning-review
S3_ADDRESSING_STYLE=path
S3_KEY_PREFIX=

# --- Backblaze B2 S3-Compatible (prioritaire si renseigné dans le Secret Kubernetes morning-review-env-secret) ---
# B2_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
# B2_REGION=eu-central-003
# B2_BUCKET=mon-bucket-b2
# B2_PREFIX=morning-review
# B2_KEY_ID=003...
# B2_APPLICATION_KEY=K003...

# --- Embeddings CPU Locaux (FastEmbed ONNX natif, 220 Mo, pré-baké en prod dans /opt/models) ---
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
FASTEMBED_CACHE_PATH=/tmp/fastembed_cache
OMP_NUM_THREADS=2
TOPIC_SIMILARITY_THRESHOLD=0.84
TOPIC_WINDOW_DAYS=14

# --- OpenRouter LLM (:free tier avec plafond 20 RPM / 1000 RPD) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_PRIMARY_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free
OPENROUTER_MAX_RPM=15
OPENROUTER_MAX_RPD=900

# --- Connecteur Gmail Initial (lu depuis .env pour BOOTSTRAP_USER_ID) & Envoi SMTP ---
GMAIL_ACCOUNT=mathieuv.alterai@gmail.com
GMAIL_PWD=xxxx-xxxx-xxxx-xxxx
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_CURATION_LABEL=INBOX
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=465
DIGEST_RECIPIENT_EMAIL=mathieu.veron@gmail.com
PUBLIC_UI_URL=https://review.perso.frenchtoast.dev
DAILY_DIGEST_SEND_HOUR=7

# --- Archivage Dépôt Git (associé à BOOTSTRAP_USER_ID en MVP, puis par user_id) ---
GIT_ARCHIVE_REPO_URL=
GIT_ARCHIVE_BRANCH=main
GIT_ARCHIVE_TOKEN=

# --- Pont Edge Sync (agent-auth-mcp -> Morning Review API) ---
AGENT_AUTH_MCP_DIR=/home/mathieu/dev/projects/perso/agent-auth-mcp
